datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ============================================================
// USER DOMAIN
// ============================================================

model User {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  email           String             @unique
  name            String
  passwordHash    String
  isActive        Boolean            @default(true)
  isEmailVerified Boolean            @default(false)
  avatarUrl       String?
  searchCount     Int                @default(0)

  vehicles        Vehicle[]
  savedFixes      SavedFix[]
  refreshTokens   UserRefreshToken[]
  searchHistory   SearchQuery[]
  profileViews    MechanicProfileView[]

  @@index([email])
}

model Vehicle {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String
  make         String
  model        String
  year         Int
  trim         String?
  vin          String?
  licensePlate String?
  plateState   String?
  notes        String?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedFixes   SavedFix[]

  @@index([userId])
  @@index([vin])
}

model UserRefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model SavedFix {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  vehicleId String?
  query     String
  fixData   Json

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ============================================================
// MECHANIC DOMAIN
// ============================================================

model Mechanic {
  id                   String               @id @default(cuid())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Auth
  email                String?              @unique
  passwordHash         String?
  isEmailVerified      Boolean              @default(false)

  // Profile
  name                 String
  slug                 String               @unique
  bio                  String?              @db.Text
  imageUrl             String?
  shopName             String?
  phone                String?
  website              String?

  // Location
  location             String
  latitude             Float?
  longitude            Float?
  serviceRadius        Int?

  // Experience
  yearsExperience      Int
  sinceYear            Int
  certifications       String[]
  badges               String[]

  // Stats (cached/computed)
  rating               Float                @default(0)
  reviewCount          Int                  @default(0)
  profileViews         Int                  @default(0)
  searchAppearances    Int                  @default(0)
  linkClicks           Int                  @default(0)

  // Status
  isActive             Boolean              @default(false)

  // Subscription
  subscriptionStatus   SubscriptionStatus   @default(INACTIVE)
  subscriptionTier     SubscriptionTier?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStartAt  DateTime?
  subscriptionEndAt    DateTime?
  trialEndsAt          DateTime?

  skills               MechanicSkill[]
  reviews              Review[]
  refreshTokens        MechanicRefreshToken[]
  subscription         MechanicSubscription?
  profileViewLogs      MechanicProfileView[]
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SubscriptionTier {
  BASIC
  PRO
  PREMIUM
}

model MechanicRefreshToken {
  id         String   @id @default(cuid())
  mechanicId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([mechanicId])
  @@index([token])
  @@index([expiresAt])
}

model MechanicSubscription {
  id                   String           @id @default(cuid())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  mechanicId           String           @unique
  stripeSubscriptionId String           @unique
  stripeCustomerId     String
  tier                 SubscriptionTier
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean          @default(false)
  trialStart           DateTime?
  trialEnd             DateTime?

  mechanic             Mechanic         @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([mechanicId])
  @@index([stripeSubscriptionId])
}

model Skill {
  id        String          @id @default(cuid())
  name      String          @unique
  category  String?

  mechanics MechanicSkill[]
}

model MechanicSkill {
  id         String   @id @default(cuid())
  mechanicId String
  skillId    String

  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([mechanicId, skillId])
}

model Review {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  rating             Int
  reviewerName       String
  reviewerLocation   String
  reviewText         String   @db.Text
  carModel           String
  carYear            Int
  serviceDescription String
  mechanicId         String
  photoUrls          String[] @default([])

  mechanic           Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([mechanicId])
  @@index([rating])
  @@index([createdAt])
}

// ============================================================
// REPAIR KNOWLEDGE BASE
// ============================================================

model RepairGuide {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  title               String
  slug                String           @unique
  symptom             String
  systemCategory      String
  vehicleMakes        String[]
  vehicleModels       String[]
  yearFrom            Int?
  yearTo              Int?
  difficulty          RepairDifficulty
  estimatedCostMinCents Int?
  estimatedCostMaxCents Int?
  timeEstimateMinutes Int?
  diyFriendly         Boolean          @default(true)
  steps               Json
  tools               String[]
  parts               String[]
  warnings            String[]
  relatedSkills       String[]
  sources             Json?
  isPublished         Boolean          @default(true)

  @@index([systemCategory])
  @@index([symptom])
  @@index([isPublished])
}

enum RepairDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum SafetyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProcedureSourceType {
  INTERNAL
  LICENSED
  IMPORTED
}

enum WarningSeverity {
  INFO
  WARNING
  DANGER
}

// ============================================================
// REPAIR KNOWLEDGE V2 (normalized; RepairGuide kept for migration)
// ============================================================

model VehicleMakeCatalog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  slug          String   @unique
  isActive      Boolean  @default(true)
  isDailyDriver Boolean  @default(true)
  source        String?

  models   VehicleModelCatalog[]
  fitments GuideFitment[]
  recalls  RecallReference[]

  @@unique([name])
  @@index([isActive, isDailyDriver])
}

model VehicleModelCatalog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  makeId    String
  name      String
  slug      String
  isActive  Boolean  @default(true)

  make     VehicleMakeCatalog    @relation(fields: [makeId], references: [id], onDelete: Cascade)
  years    VehicleYearCatalog[]
  trims    VehicleTrimCatalog[]
  engines  VehicleEngineCatalog[]
  fitments GuideFitment[]
  recalls  RecallReference[]

  @@unique([makeId, slug])
  @@index([makeId, name])
}

model VehicleYearCatalog {
  id      String @id @default(cuid())
  modelId String
  year    Int

  model VehicleModelCatalog @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, year])
  @@index([year])
}

model VehicleTrimCatalog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modelId   String
  name      String
  slug      String
  yearFrom  Int?
  yearTo    Int?

  model    VehicleModelCatalog @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fitments GuideFitment[]

  @@unique([modelId, slug])
  @@index([modelId, yearFrom, yearTo])
}

model VehicleEngineCatalog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  modelId       String
  name          String
  displacementL Float?
  fuelType      String?
  aspiration    String?
  cylinders     Int?
  yearFrom      Int?
  yearTo        Int?

  model    VehicleModelCatalog @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fitments GuideFitment[]

  @@index([modelId, name])
}

model IssueCategory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  slug        String   @unique
  description String?

  issues Issue[]

  @@unique([name])
}

model Issue {
  id             String      @id @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  categoryId     String
  name           String
  slug           String      @unique
  symptomSummary String      @db.Text
  diyFriendly    Boolean     @default(true)
  safetyLevel    SafetyLevel @default(MEDIUM)
  isPublished    Boolean     @default(true)

  category       IssueCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  aliases        IssueAlias[]
  searchMappings SearchIntentMapping[]
  procedures     FixProcedure[]

  @@unique([categoryId, name])
  @@index([categoryId, isPublished])
}

model IssueAlias {
  id      String @id @default(cuid())
  issueId String
  alias   String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, alias])
  @@index([alias])
}

model SearchIntentMapping {
  id      String @id @default(cuid())
  issueId String
  phrase  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, phrase])
  @@index([phrase])
}

model FixProcedure {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  issueId               String
  title                 String
  slug                  String              @unique
  difficulty            RepairDifficulty
  diyFriendly           Boolean             @default(true)
  estimatedCostMinCents Int?
  estimatedCostMaxCents Int?
  timeEstimateMinutes   Int?
  summary               String              @db.Text
  diagnosisNotes        String?             @db.Text
  whenToStop            String?             @db.Text
  sourceType            ProcedureSourceType
  sourceConfidence      Float               @default(0.5)
  isPublished           Boolean             @default(true)

  issue      Issue                      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  steps      FixProcedureStep[]
  tools      FixProcedureTool[]
  parts      FixProcedurePart[]
  warnings   FixProcedureWarning[]
  fitments   GuideFitment[]
  sourceRefs ProcedureSourceReference[]

  @@index([issueId, isPublished])
  @@index([sourceType, sourceConfidence])
}

model FixProcedureStep {
  id            String  @id @default(cuid())
  procedureId   String
  stepNumber    Int
  title         String?
  body          String  @db.Text
  isDiagnostic  Boolean @default(false)
  requiresLift  Boolean @default(false)

  procedure FixProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([procedureId, stepNumber])
}

model FixProcedureTool {
  id          String  @id @default(cuid())
  procedureId String
  name        String
  notes       String?

  procedure FixProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}

model FixProcedurePart {
  id           String  @id @default(cuid())
  procedureId  String
  name         String
  quantity     String?
  notes        String?
  isConsumable Boolean @default(false)

  procedure FixProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}

model FixProcedureWarning {
  id          String          @id @default(cuid())
  procedureId String
  severity    WarningSeverity
  message     String          @db.Text

  procedure FixProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId, severity])
}

model GuideFitment {
  id           String  @id @default(cuid())
  procedureId  String
  makeId       String
  modelId      String?
  trimId       String?
  engineId     String?
  yearFrom     Int?
  yearTo       Int?
  notes        String? @db.Text
  confidence   Float   @default(1.0)

  procedure FixProcedure         @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  make      VehicleMakeCatalog   @relation(fields: [makeId], references: [id], onDelete: Cascade)
  model     VehicleModelCatalog? @relation(fields: [modelId], references: [id], onDelete: Cascade)
  trim      VehicleTrimCatalog?  @relation(fields: [trimId], references: [id], onDelete: Cascade)
  engine    VehicleEngineCatalog? @relation(fields: [engineId], references: [id], onDelete: Cascade)

  @@index([makeId, modelId, yearFrom, yearTo])
  @@index([trimId])
  @@index([engineId])
}

model ExternalSource {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String   @unique
  sourceType String
  baseUrl    String?
  isActive   Boolean  @default(true)

  refs ProcedureSourceReference[]
}

model ProcedureSourceReference {
  id           String    @id @default(cuid())
  procedureId  String
  sourceId     String
  externalId   String?
  sourceUrl    String?
  licenseScope String?
  fetchedAt    DateTime?
  rawPayload   Json?

  procedure FixProcedure   @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  source    ExternalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([procedureId])
  @@index([sourceId, externalId])
}

model RecallReference {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  makeId        String?
  modelId       String?
  year          Int?
  nhtsaCampaign String
  component     String?
  summary       String    @db.Text
  consequence   String?   @db.Text
  remedy        String?   @db.Text
  reportDate    DateTime?
  sourceUrl     String?

  make  VehicleMakeCatalog?  @relation(fields: [makeId], references: [id], onDelete: SetNull)
  model VehicleModelCatalog? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([makeId, modelId, year])
  @@index([nhtsaCampaign])
}

model SearchMiss {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  query           String
  make            String?
  model           String?
  year            Int?
  trim            String?
  normalizedIssue String?
  reason          String?
  userId          String?
  sessionId       String?

  @@index([createdAt])
  @@index([normalizedIssue])
  @@index([make, model, year])
}

// ============================================================
// ANALYTICS
// ============================================================

model SearchQuery {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  query        String
  make         String?
  model        String?
  year         Int?
  userId       String?
  sessionId    String?
  resultsCount Int      @default(0)

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([query])
  @@index([userId])
  @@index([sessionId])
}

model MechanicProfileView {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  mechanicId  String
  userId      String?
  sessionId   String?
  source      String?
  clickedLink Boolean  @default(false)

  mechanic    Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mechanicId])
  @@index([createdAt])
  @@index([userId])
}

// ============================================================
// ADMIN DOMAIN
// ============================================================

model AdminUser {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String
  passwordHash        String
  role                String
  isActive            Boolean             @default(true)
  failedLoginAttempts Int                 @default(0)
  lastFailedLoginAt   DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  refreshTokens       AdminRefreshToken[]
  auditLogs           AuditLog[]

  @@index([email])
}

model AdminRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
}

model AuditLog {
  id           String    @id @default(cuid())
  timestamp    DateTime  @default(now())
  actorId      String
  actorEmail   String
  actorRole    String
  action       String
  resourceType String
  resourceId   String
  changes      Json?
  ipAddress    String?
  userAgent    String?
  metadata     Json?

  actor        AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([timestamp])
  @@index([action])
  @@index([resourceType])
}
