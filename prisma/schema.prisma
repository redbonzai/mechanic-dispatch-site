datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ============================================================
// USER DOMAIN
// ============================================================

model User {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  email           String             @unique
  name            String
  passwordHash    String
  isActive        Boolean            @default(true)
  isEmailVerified Boolean            @default(false)
  avatarUrl       String?
  searchCount     Int                @default(0)

  vehicles        Vehicle[]
  savedFixes      SavedFix[]
  refreshTokens   UserRefreshToken[]
  searchHistory   SearchQuery[]
  profileViews    MechanicProfileView[]

  @@index([email])
}

model Vehicle {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String
  make         String
  model        String
  year         Int
  trim         String?
  vin          String?
  licensePlate String?
  plateState   String?
  notes        String?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedFixes   SavedFix[]

  @@index([userId])
  @@index([vin])
}

model UserRefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model SavedFix {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  vehicleId String?
  query     String
  fixData   Json

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ============================================================
// MECHANIC DOMAIN
// ============================================================

model Mechanic {
  id                   String               @id @default(cuid())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Auth
  email                String?              @unique
  passwordHash         String?
  isEmailVerified      Boolean              @default(false)

  // Profile
  name                 String
  slug                 String               @unique
  bio                  String?              @db.Text
  imageUrl             String?
  shopName             String?
  phone                String?
  website              String?

  // Location
  location             String
  latitude             Float?
  longitude            Float?
  serviceRadius        Int?

  // Experience
  yearsExperience      Int
  sinceYear            Int
  certifications       String[]
  badges               String[]

  // Stats (cached/computed)
  rating               Float                @default(0)
  reviewCount          Int                  @default(0)
  profileViews         Int                  @default(0)
  searchAppearances    Int                  @default(0)
  linkClicks           Int                  @default(0)

  // Status
  isActive             Boolean              @default(false)

  // Subscription
  subscriptionStatus   SubscriptionStatus   @default(INACTIVE)
  subscriptionTier     SubscriptionTier?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStartAt  DateTime?
  subscriptionEndAt    DateTime?
  trialEndsAt          DateTime?

  skills               MechanicSkill[]
  reviews              Review[]
  refreshTokens        MechanicRefreshToken[]
  subscription         MechanicSubscription?
  profileViewLogs      MechanicProfileView[]
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SubscriptionTier {
  BASIC
  PRO
  PREMIUM
}

model MechanicRefreshToken {
  id         String   @id @default(cuid())
  mechanicId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([mechanicId])
  @@index([token])
  @@index([expiresAt])
}

model MechanicSubscription {
  id                   String           @id @default(cuid())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  mechanicId           String           @unique
  stripeSubscriptionId String           @unique
  stripeCustomerId     String
  tier                 SubscriptionTier
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean          @default(false)
  trialStart           DateTime?
  trialEnd             DateTime?

  mechanic             Mechanic         @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([mechanicId])
  @@index([stripeSubscriptionId])
}

model Skill {
  id        String          @id @default(cuid())
  name      String          @unique
  category  String?

  mechanics MechanicSkill[]
}

model MechanicSkill {
  id         String   @id @default(cuid())
  mechanicId String
  skillId    String

  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([mechanicId, skillId])
}

model Review {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  rating             Int
  reviewerName       String
  reviewerLocation   String
  reviewText         String   @db.Text
  carModel           String
  carYear            Int
  serviceDescription String
  mechanicId         String
  photoUrls          String[] @default([])

  mechanic           Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([mechanicId])
  @@index([rating])
  @@index([createdAt])
}

// ============================================================
// REPAIR KNOWLEDGE BASE
// ============================================================

model RepairGuide {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  title               String
  slug                String           @unique
  symptom             String
  systemCategory      String
  vehicleMakes        String[]
  vehicleModels       String[]
  yearFrom            Int?
  yearTo              Int?
  difficulty          RepairDifficulty
  estimatedCostMinCents Int?
  estimatedCostMaxCents Int?
  timeEstimateMinutes Int?
  diyFriendly         Boolean          @default(true)
  steps               Json
  tools               String[]
  parts               String[]
  warnings            String[]
  relatedSkills       String[]
  sources             Json?
  isPublished         Boolean          @default(true)

  @@index([systemCategory])
  @@index([symptom])
  @@index([isPublished])
}

enum RepairDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

// ============================================================
// ANALYTICS
// ============================================================

model SearchQuery {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  query        String
  make         String?
  model        String?
  year         Int?
  userId       String?
  sessionId    String?
  resultsCount Int      @default(0)

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([query])
  @@index([userId])
  @@index([sessionId])
}

model MechanicProfileView {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  mechanicId  String
  userId      String?
  sessionId   String?
  source      String?
  clickedLink Boolean  @default(false)

  mechanic    Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mechanicId])
  @@index([createdAt])
  @@index([userId])
}

// ============================================================
// ADMIN DOMAIN
// ============================================================

model AdminUser {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String
  passwordHash        String
  role                String
  isActive            Boolean             @default(true)
  failedLoginAttempts Int                 @default(0)
  lastFailedLoginAt   DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  refreshTokens       AdminRefreshToken[]
  auditLogs           AuditLog[]

  @@index([email])
}

model AdminRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
}

model AuditLog {
  id           String    @id @default(cuid())
  timestamp    DateTime  @default(now())
  actorId      String
  actorEmail   String
  actorRole    String
  action       String
  resourceType String
  resourceId   String
  changes      Json?
  ipAddress    String?
  userAgent    String?
  metadata     Json?

  actor        AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([timestamp])
  @@index([action])
  @@index([resourceType])
}
