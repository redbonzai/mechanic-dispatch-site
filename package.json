{
  "name": "mechanic-dispatch-site",
  "version": "1.8.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "postinstall": "if [ \"$CI\" != \"true\" ] && [ -f prisma/schema.prisma ]; then prisma generate; fi",
    "prebuild": "pnpm prisma:generate",
    "build": "nest build",
    "build:release": "pnpm prisma:generate && nx build mechanic-dispatch-site-api",
    "build:nx": "nx build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:nx": "nx serve",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:nx": "nx lint",
    "pretest": "pnpm prisma:generate",
    "test": "jest --selectProjects unit",
    "test:all": "jest --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:nx": "nx test",
    "test:watch": "jest --selectProjects unit --watch",
    "test:watch:nx": "nx test --watch",
    "test:cov": "jest --coverage --selectProjects unit",
    "test:cov:nx": "nx test --codeCoverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:nx": "nx test:e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:setup": "./scripts/setup-db.sh",
    "db:test:create": "docker compose exec -T db psql -U postgres -c \"CREATE DATABASE mechanic_test;\"",
    "db:reset": "prisma migrate reset --force --skip-seed && pnpm prisma generate && pnpm prisma db seed",
    "db:clean": "rm -rf prisma/migrations/20250115000000_add_mechanics_reviews_skills prisma/migrations/202511151100_payment_workflow prisma/migrations/20251115160659_init prisma/migrations/20251115195905_init && echo '✅ Old migrations removed'",
    "test:build": "DATABASE_URL='postgresql://dummy:dummy@localhost:5432/dummy?schema=public' pnpm prisma generate && pnpm build",
    "fix:all": "./scripts/fix-all.sh",
    "commitlint:check": "commitlint --from=origin/main --to=HEAD",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.6.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "prisma": "7.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^20.4.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@jest/test-sequencer": "30.3.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nx/eslint": "^22.3.3",
    "@nx/jest": "^22.3.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.4.2",
    "semantic-release": "^25.0.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "prisma": {
    "seed": "./node_modules/.bin/tsx prisma/seed.ts"
  }
}
