{
  "name": "mechanic-dispatch-web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "prebuild": "node scripts/generate-api-base.mjs",
    "prestart": "node scripts/generate-api-base.mjs",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "build:dev": "node scripts/generate-api-base.mjs && ng build --configuration development",
    "pretest": "node scripts/generate-api-base.mjs",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@stripe/stripe-js": "^9.8.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@nx/angular": "^22.7.5",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.9.3",
    "angular-eslint": "22.0.0",
    "eslint": "^10.5.0",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.0"
  }
}