{
  "name": "mechanic-dispatch-web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "prebuild": "node scripts/generate-api-base.mjs",
    "prestart": "node scripts/generate-api-base.mjs",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "build:dev": "node scripts/generate-api-base.mjs && ng build --configuration development",
    "pretest": "node scripts/generate-api-base.mjs",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-browser-dynamic": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@stripe/stripe-js": "^8.11.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@nx/angular": "^22.3.3",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.5.0",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.57.1"
  }
